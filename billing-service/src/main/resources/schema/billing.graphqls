type Query {
    accounts(limit: Int = 100): [Account!]!
    account(id: ID!): Account
    overview: Overview!
    events(accountId: ID): [BillingEvent!]!
}
type Account {
    id: ID!
    company: String!
    billingEmail: String
    plan: String!
    status: String!
    monthlyRate: String!
    currency: String!
    version: Int!
    syncStatus: String!
    syncedVersion: Int
    createdAt: String!
    updatedAt: String!
    outstandingBalance: String!
    transactions: [LedgerTransaction!]!
}
type LedgerTransaction {
    id: ID!
    accountId: ID!
    kind: String!
    amount: String!
    description: String!
    actor: String!
    accountVersion: Int!
    createdAt: String!
    entries: [LedgerEntry!]!
}
type LedgerEntry {
    id: ID!
    transactionId: ID!
    ledgerAccount: String!
    side: String!
    amount: String!
}
type BillingEvent {
    id: ID!
    accountId: ID!
    accountVersion: Int!
    type: String!
    status: String!
    attempts: Int!
    createdAt: String!
    nextAttemptAt: String!
    deliveredAt: String
    lastError: String
}
type Overview {
    totalAccounts: Int!
    activeAccounts: Int!
    monthlyRevenue: String!
    syncedAccounts: Int!
    pendingEvents: Int!
    failedEvents: Int!
    deliveredEvents: Int!
    demo: Boolean!
    platformAvailable: Boolean!
}
